# Email configuration (sendmail on shared hosting)
# Set EMAIL_TRANSPORT=ethereal to capture emails locally via Ethereal (no extra package needed).
# A preview URL will be printed to the console after each send.
# Leave unset to use sendmail in production.
EMAIL_TRANSPORT=ethereal
FROM_EMAIL=forms@example.com
ADMIN_EMAIL=admin@example.com
PAYMENT_EMAIL=payment@example.com
